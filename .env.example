# Supabase Configuration
# Main project - app_state key-value storage
VITE_SUPABASE_MAIN_URL=https://obxgfqztkbmoqyicjjuk.supabase.co
VITE_SUPABASE_MAIN_KEY=your_main_publishable_key_here

# Secondary project - attendance check-in data (read-only)
VITE_SUPABASE_SECONDARY_URL=https://vayvssbxuskhyujtbtyw.supabase.co
VITE_SUPABASE_SECONDARY_KEY=your_secondary_publishable_key_here

# Cloudinary - leave attachments (images / PDFs)
# The upload preset MUST be an *unsigned* one: Cloudinary console -> Settings ->
# Upload -> Upload presets -> Add upload preset -> Signing Mode: Unsigned.
# Both values are public by design; the API secret never reaches the browser.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=leave_attachments
